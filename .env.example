# ---------------------------------------------------------------
# Local development configuration (read by docker-compose and the API)
# ---------------------------------------------------------------

# Database (local Postgres started via: docker compose up -d db)
DB_HOST=localhost
DB_PORT=5435
DB_USER=ticketing
DB_PASSWORD=ticketing
DB_NAME=ticketing
DB_DIALECT=postgres
DB_SSL=disable

# API server
API_PORT=8080
CORS_ORIGIN=http://localhost:5180
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
COOKIE_SECURE=false
MIGRATIONS_DIR=../db/migrations

# Default admin seeded on startup (receives all new tickets)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Default Admin


# Optional: HTTPS + HTTP/2 for the API (leave empty for plain HTTP locally)
TLS_CERT_FILE=
TLS_KEY_FILE=
